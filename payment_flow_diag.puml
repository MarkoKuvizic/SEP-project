@startuml
title Card Payment Flow (Shop + PSP + Bank)\nwith Separate Frontends and Backends

actor User

box "Shop Application" #LightBlue
participant "Shop FE" as ShopFE
participant "Shop BE" as ShopBE
end box

box "PSP Application" #LightGreen
participant "PSP FE" as PSPFE
participant "PSP BE" as PSPBE
end box

box "Bank Application" #LightYellow
participant "Bank FE" as BankFE
participant "Bank BE" as BankBE
end box

== Checkout & Payment Initialization ==

User -> ShopFE : Click "Pay with Card"
ShopFE -> ShopBE : POST /payments/init\n(amount, currency, orderId)
ShopBE -> PSPBE : POST /psp/init\n(amount, currency,\nsuccessUrl, failUrl, merchantOrderId)

activate PSPBE
PSPBE -> PSPBE : Create PSP transaction (INIT)
PSPBE -> BankBE : POST /bank/init\n(amount, currency,\npspTxId, callbackUrl)
activate BankBE
BankBE -> BankBE : Create Bank transaction (INIT)
BankBE --> PSPBE : InitBankResponse\n(bankTxId, paymentUrl)
deactivate BankBE

PSPBE -> PSPBE : Store mapping\n(pspTxId ↔ bankTxId)
PSPBE --> ShopBE : InitResponse\n(pspTxId, paymentUrl)
deactivate PSPBE

ShopBE --> ShopFE : paymentUrl
ShopFE -> User : Redirect to PSP / Bank

== User Enters Card Data ==

User -> PSPFE : Open PSP payment page
PSPFE -> BankFE : Redirect to Bank card payment page

User -> BankFE : Enter card data\n(PAN, expiry, CVV)
BankFE -> BankBE : POST /pay\n(card data, bankTxId)

== Payment Processing ==

activate BankBE
BankBE -> BankBE : Validate card
BankBE -> BankBE : Simulate authorization & capture
BankBE -> BankBE : Update transaction status (SUCCESS / FAIL)
deactivate BankBE

== Asynchronous Callback ==

BankBE -> PSPBE : POST /callback\n(bankTxId, status,\namount, signature)
activate PSPBE
PSPBE -> PSPBE : Validate signature
PSPBE -> PSPBE : Update PSP transaction status
PSPBE -> ShopBE : POST /callback\n(pspTxId, status,\namount)
deactivate PSPBE

activate ShopBE
ShopBE -> ShopBE : Update order status
deactivate ShopBE

== User Redirect (UX Only) ==

BankFE -> User : Redirect to successUrl / failUrl
User -> ShopFE : View payment result page

note right of ShopBE
Callback is authoritative.
Redirect is informational only.
end note

@enduml
